# Which Invoice4U environment this process talks to. Required — there is no
# silent production default.
INVOICE4U_ENV=qa

# How the API key is found. Pick ONE.
#
# (a) Keychain (recommended on macOS). The value is an arbitrary label, not a
#     business name the server understands — it is only the Keychain account.
#     Store the key with:
#       security add-generic-password -s invoice4u -a my-business -U -w
#     (put -w last and it prompts, so the key never enters your shell history)
INVOICE4U_ACCOUNT=my-business
#
# (b) Direct, for CI or containers with no Keychain.
# INVOICE4U_API_KEY=...

# Optional but recommended: refuse to start unless the key opens this
# organisation. Prevents a misfiled key from acting on the wrong company.
# INVOICE4U_EXPECT_ORG=123456789

# Draft tools (create / update / delete) are not registered at all unless this
# is exactly "true". Drafts are the entire write surface: nothing here can
# issue, cancel or send a document.
INVOICE4U_ALLOW_WRITES=false

# auto (default) | exchange | direct — see README, "Authentication".
INVOICE4U_AUTH_MODE=auto

# error | warn | info | debug
INVOICE4U_LOG_LEVEL=info

# Keychain service name, if you want something other than "invoice4u".
# INVOICE4U_KEYCHAIN_SERVICE=invoice4u
